// Not all mod values are commutative -- might be a subtract
RVTT_FN (sfpiadd_v,            ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                          EXP|CC(0x505), ({M,0x555},{}), ECF)
RVTT_FN (sfpiadd_v_lv,         ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC_USI,                  EXP|LV|CC(0x505), ({M,0x555},{}), ECF)

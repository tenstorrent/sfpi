// loads can change rwc depending on unobserved state :(
RVTT_FN (sfpload,              ,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI,                 VOL, ({CE,14},{M,0xffff},{CU,2}), ECF)
RVTT_OVR(sfpload,            bh,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI,                 VOL, ({CE,13},{M,0xcfff},{CU,3}), ECF)
RVTT_OVR(sfpload,           qsr,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI_USI,                 VOL, ({CE,10},{M,0xcfff},{CU,3}), ECF)
RVTT_FN (sfpload_lv,           ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,         VOL|LV, ({CE,14},{M,0xffff},{CU,2}), ECF)
RVTT_OVR(sfpload_lv,         bh,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,         VOL|LV, ({CE,13},{M,0xcfff},{CU,3}), ECF)
RVTT_OVR(sfpload_lv,        qsr,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,         VOL|LV, ({CE,10},{M,0xcfff},{CU,3}), ECF)

RVTT_FN (sfploadsrcs_lv,    qsr,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI_USI,     VOL|LV, ({CE,10},{M,0xcfff},{CU,3},{CU,1}), ECF)
RVTT_FN (sfpstore,             ,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,            VOL, ({CE,14},{M,0xffff},{CU,2}), ECF)
RVTT_OVR(sfpstore,           bh,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,            VOL, ({CE,13},{M,0xcfff},{CU,3}), ECF)
RVTT_OVR(sfpstore,          qsr,,VOID_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI_USI,            VOL, ({CE,10},{M,0xcfff},{CU,3}), ECF)

RVTT_FN (sfpshft_v,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            0, ({M,0x1}), ECF)
RVTT_OVR(sfpshft_v,    bh_qsr,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            0, ({M,0x5}), ECF)

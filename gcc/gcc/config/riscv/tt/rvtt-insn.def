// The _lv instructions MUST follow the non-live versions of the same instruction

// FN defines a builtin
// OVR defines an override
#ifndef RVTT_FN
#define RVTT_FN(a, b, c, d, e, f, g)
#endif

#ifndef RVTT_OVR
#define RVTT_OVR(a, b, c, d, e, f, g)
#endif

#define LV rvtt_insn_data::HAS_LV
#define CC(N) (uint32_t((N+0) ? (N+0) : 0xffff) << rvtt_insn_data::CC_MASK_SHIFT)
#define VOL rvtt_insn_data::VOLATILE
#define EXP rvtt_insn_data::EXPANDED
#define EMP rvtt_insn_data::EMPTY
#define IMM(N) (N << rvtt_insn_data::NUM_IMMS_SHIFT)

#define N rvtt_insn_data::op_t::NONE
#define R rvtt_insn_data::op_t::RUNTIME
#define M rvtt_insn_data::op_t::early (rvtt_insn_data::op_t::MOD)
#define XM rvtt_insn_data::op_t::early (rvtt_insn_data::op_t::XMOD)

#define U rvtt_insn_data::op_t::UNSIGNED
#define S rvtt_insn_data::op_t::SIGNED
#define E rvtt_insn_data::op_t::EITHER
#define CU rvtt_insn_data::op_t::checked (U)
#define CS rvtt_insn_data::op_t::checked (S)
#define CE rvtt_insn_data::op_t::checked (E)
#define EU rvtt_insn_data::op_t::early (U)
#define ES rvtt_insn_data::op_t::early (S)

#define ECF ECF_NOVOPS

// Args are (NAME, ISA, _SFX, TYPE, FLAGS, OPS, ECF)

// This is first
RVTT_FN (synth_opcode,       ,,USI_FTYPE_USI_USI,                                            0, ({U,0},{U,0}), ECF | ECF_CONST)
// add2 numbered after opcode, used for 2-immediate fns
RVTT_FN (synth_add2,         ,,USI_FTYPE_USI_USI_USI,                                        0, ({R},{R},{R}), ECF | ECF_CONST)
RVTT_FN (lreg_pressure,      ,,VOID_FTYPE_USI,                                               VOL|EMP, ({U,1}), ECF)

// These builtins are expanded to something else during compilation
RVTT_FN (sfpxlogic,          ,,USI_FTYPE_USI_USI_USI,                                        VOL, ({XM,0xf},{R},{R}), ECF)
RVTT_FN (sfpxpred,           ,,USI_FTYPE_USI_USI,                                            VOL|EMP, ({XM,0xb7},{R}), ECF)
RVTT_FN (sfpxcond,           ,,USI_FTYPE_USI_USI_USI,                                        VOL, ({XM,0x1},{R},{R}), ECF)
RVTT_FN (sfpxcmp,            ,,USI_FTYPE_XTT_VEC_XTT_VEC_USI,                                CC(), ({XM,0x3f},{}), ECF)
RVTT_FN (sfpxloadi,          ,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_SI,                        0, ({E,0},{ES,6,0}), ECF)

// If you're putting in nops, you want them preserved, so say it's volatile
RVTT_FN (sfpnop,             ,,VOID_FTYPE,                                                   VOL, (), ECF)
RVTT_FN (sfpbankdone,     qsr,,VOID_FTYPE_USI_USI_USI,                                       VOL, ({CU,1},{CU,1},{CU,1}), ECF)

RVTT_FN (sfpreadlreg,        ,,XTT_VEC_FTYPE_USI,                                            EMP, ({CU,4}), ECF)
RVTT_FN (sfpwritelreg,       ,,VOID_FTYPE_XTT_VEC_USI,                                       VOL|EMP, ({CU,3}), ECF)

RVTT_FN (sfpnovalue,         ,,XTT_VEC_FTYPE,                                                0, (), ECF)
RVTT_FN (sfpselect2,         ,,XTT_VEC_FTYPE_XTT_VEC2_USI,                                   0, ({CU,1}), ECF)
RVTT_FN (sfpselect4,         ,,XTT_VEC_FTYPE_XTT_VEC4_USI,                                   0, ({CU,2}), ECF)
RVTT_FN (sfpselect8,         ,,XTT_VEC_FTYPE_XTT_VEC8_USI,                                   0, ({CU,3}), ECF)
RVTT_FN (sfpconcat2,         ,,XTT_VEC2_FTYPE_XTT_VEC_XTT_VEC,                               0, (), ECF)

RVTT_FN (sfpsetcc,        ,_wh,VOID_FTYPE_XTT_VEC_USI,                                       CC(), ({M,0x55}), ECF)
RVTT_OVR(sfpsetcc,        qsr,,VOID_FTYPE_XTT_VEC_USI_USI,                                   CC(), ({M,0x55},{U,1}), ECF)
RVTT_FN (sfpencc,            ,,VOID_FTYPE_USI_USI,                                           CC(), ({M,0x707},{U,2}), ECF)
RVTT_FN (sfpcompc,           ,,VOID_FTYPE,                                                   CC(), (), ECF)
RVTT_FN (sfppushc,           ,,VOID_FTYPE_USI,                                               VOL|CC(0x2000), ({M,0xffff}), ECF)
RVTT_FN (sfppopc,            ,,VOID_FTYPE_USI,                                               VOL|CC(), ({M,0xffff}), ECF)

// sfpassign is a placeholder to allow describing some combines
// simply -- that pass then elides any actual uses.  Marked as empty because they often go away.
RVTT_FN (sfpassign,          ,,XTT_VEC_FTYPE_XTT_VEC,                                        EMP, (), ECF)
RVTT_FN (sfpassign_lv,       ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                LV|EMP, (), ECF)

RVTT_FN (sfploadi,           ,,XTT_VEC_FTYPE_XTT_IPTR_USI_USI_USI_USI,                       0, ({E,16,0},{M,0x17}), ECF)
RVTT_FN (sfploadi_lv,        ,,XTT_VEC_FTYPE_XTT_IPTR_XTT_VEC_USI_USI_USI_USI,               LV, ({U,16,0},{M,0x517}), ECF)

// Although sfpmov permits 0x107 for mask bits, only 0x2 makes sense here -- all other cases should be expressed differently
RVTT_FN (sfpmov,             ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M,0x2}), ECF)
RVTT_FN (sfpmov_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV, ({M,0x2}), ECF)
RVTT_FN (sfpexexp,           ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    CC(0xf0c), ({M,0xf0f}), ECF)
RVTT_FN (sfpexexp_lv,        ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV|CC(0xf0c), ({M,0xf0f}), ECF)
RVTT_FN (sfpexman,           ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M,0x3}), ECF)
RVTT_FN (sfpexman_lv,        ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV, ({M,0x3}), ECF)
RVTT_FN (sfpabs,             ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    0, ({M,0x3}), ECF)
RVTT_FN (sfpabs_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV, ({M,0x3}), ECF)
RVTT_FN (sfplz,              ,,XTT_VEC_FTYPE_XTT_VEC_USI,                                    CC(0x54), ({M,0x5555}), ECF)
RVTT_FN (sfplz_lv,           ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_USI,                            LV|CC(0x54), ({M,0x5555}), ECF)

RVTT_FN (sfpand,             ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, (), ECF)
RVTT_OVR(sfpand,           bh,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC,                                0, (), ECF)
RVTT_FN (sfpand_lv,          ,,XTT_VEC_FTYPE_XTT_VEC_XTT_VEC_XTT_VEC,                        LV, (), ECF)
